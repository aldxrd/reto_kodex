<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Api">
            <directory>tests/Api</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Las pruebas de API usan una BD separada que se recrea en cada test. -->
        <env name="DB_NAME" value="kodex_test" force="false"/>
        <env name="JWT_SECRET" value="test-secret-test-secret-test-secret-1234" force="true"/>
        <env name="JWT_TTL" value="3600" force="true"/>
        <env name="LOGIN_MAX_ATTEMPTS" value="3" force="true"/>
        <env name="LOGIN_LOCK_MINUTES" value="15" force="true"/>
        <env name="CORS_ORIGINS" value="http://localhost:8000" force="true"/>
    </php>
</phpunit>
