# Copiar a .env y ajustar. Nunca subir .env al repositorio.

APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kodex
DB_USER=kodex
DB_PASS=kodex

# Mínimo 32 caracteres. Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-64-caracteres-hex
# Duración del token en segundos (8 horas)
JWT_TTL=28800

# Bloqueo tras N intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000
